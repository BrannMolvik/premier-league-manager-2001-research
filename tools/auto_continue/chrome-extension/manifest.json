{
  "manifest_version": 3,
  "name": "FM2001 ChatGPT Auto Continue",
  "version": "0.3.3",
  "description": "Prevents stale-heartbeat recovery from interrupting actively generating ChatGPT workers; keeps bounded recovery for real stalls and errors.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FM2001 Auto Continue"
  }
}
